---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Giscus from '../../components/Giscus.astro';
import { formatDate } from '../../utils/formatters';
import { getPosts, type Post } from '../../utils/writing';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} — Theo Farrell`}
  description={post.data.summary ?? `${post.data.title} — writing by Theo Farrell`}
  ogUrl={`https://theosdoor.github.io/writing/${post.id}/`}
>
  <main class="mx-auto w-full max-w-[800px] px-5 py-16 sm:px-8" id="main" tabindex="-1">
    <article class="animate-[fade-up_0.7s_var(--ease-smooth)_forwards]">
      <header class="mb-8 border-b border-rule pb-6">
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">
          {formatDate(post.data.date)}
        </p>
        <h1 class="mt-3 font-serif text-4xl font-black leading-tight text-ink">{post.data.title}</h1>
      </header>

      <div class="prose max-w-none font-sans text-sm leading-[1.6rem] tracking-wide text-muted
                  [&_p]:mb-6
                  [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:font-black [&_h2]:text-ink
                  [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-serif [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-ink
                  [&_hr]:border-t [&_hr]:border-rule [&_hr]:my-10
                  [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-4 [&_blockquote]:italic
                  [&_ul]:mb-6 [&_ul]:list-none [&_ul]:pl-0 [&_ul]:space-y-3
                  [&_ul_li]:relative [&_ul_li]:pl-6
                  [&_ul_li::before]:content-[''] [&_ul_li::before]:absolute [&_ul_li::before]:left-1 [&_ul_li::before]:top-[11px] [&_ul_li::before]:size-1.5 [&_ul_li::before]:rounded-full [&_ul_li::before]:bg-accent
                  [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-3
                  [&_code]:rounded [&_code]:bg-panel [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.85em]
                  [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:border [&_pre]:border-rule [&_pre]:p-4
                  [&_pre_code]:bg-transparent [&_pre_code]:p-0
                  [&_img]:my-6 [&_img]:rounded-lg">
        <Content />
      </div>

      <Giscus term={post.id} />

      <div class="mt-12 border-t border-rule pt-6">
        <a href="/writing/" class="inline-flex items-center gap-2 border-b border-rule pb-1 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-ink hover:border-accent hover:text-accent transition-all">
          All writing
        </a>
      </div>
    </article>
  </main>
</Base>
