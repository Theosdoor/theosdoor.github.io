---
import Base from '../layouts/Base.astro';
import Publications from '../components/Publications.astro';
import Projects from '../components/Projects.astro';
import DecoDivider from '../components/DecoDivider.astro';
import LetsChat from '../components/LetsChat.astro';
import Talks from '../components/Talks.astro';
import FieldBuilding from '../components/FieldBuilding.astro';
import Reviewing from '../components/Reviewing.astro';
import { Content as IntroContent, frontmatter as introFrontmatter } from '../../content/intro.md';
import { Image } from 'astro:assets';
import profilePic from '../../public/images/theocool.jpeg';
---

<Base
  title="Theo Farrell"
  description="Theo Farrell — Durham University MSci Natural Sciences, AI safety researcher & group organiser"
  ogUrl="https://theosdoor.github.io/"
>
  <main id="main" class="w-full px-5 py-16 sm:px-8" tabindex="-1">
    <div id="panel-home" role="tabpanel" aria-labelledby="tab-home">
      <div class="mx-auto w-full max-w-[560px] md:max-w-[800px]">
        <header class="mb-12 animate-[fade-up_0.7s_var(--ease-smooth)_forwards]">
          <div class="flex flex-col gap-8 md:flex-row-reverse md:items-start md:justify-between md:gap-12">
            <!-- Image (right on desktop, top on mobile) -->
            <div class="deco-frame mb-6 size-36 shrink-0 border border-accent bg-panel p-1 md:mb-0 md:size-44">
              <Image 
                class="size-full object-cover object-[80%_80%]" 
                src={profilePic} 
                alt={introFrontmatter.name} 
                width={176} 
                height={176} 
                loading="eager"
                fetchpriority="high" 
              />
            </div>
            
            <!-- Text (left on desktop, bottom on mobile) -->
            <div class="flex-1">
              <p class="mb-3 font-sans text-xs font-semibold uppercase tracking-[0.28em] text-accent-strong">{introFrontmatter.subtitle}</p>
              <h1 class="mb-6 font-serif text-5xl font-black leading-tight text-ink sm:text-6xl">{introFrontmatter.name}</h1>
              <DecoDivider class="mb-6 max-w-44" />
              <div class="prose font-sans text-sm leading-[1.4rem] tracking-wide text-muted space-y-4">
                <IntroContent />
              </div>
            </div>
          </div>
        </header>

      </div>
    </div>
    <div id="panel-research" role="tabpanel" aria-labelledby="tab-research" hidden>
      <div class="mx-auto w-full max-w-[800px] flex flex-col gap-16">
        <Publications />
        <Reviewing />
        <Talks filterResearchOnly={true} />
      </div>
    </div>
    <div id="panel-field-building" role="tabpanel" aria-labelledby="tab-field-building" hidden>
      <div class="mx-auto w-full max-w-[800px]"><FieldBuilding /></div>
    </div>
    <div id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" hidden>
      <div class="mx-auto w-full max-w-[960px]"><Projects /></div>
    </div>
    <div id="panel-chat" role="tabpanel" aria-labelledby="tab-chat" hidden>
      <LetsChat headingLevel="h2" />
    </div>
  </main>
</Base>
