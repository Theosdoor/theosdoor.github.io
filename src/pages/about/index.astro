---
import Base from '../../layouts/Base.astro';
import DecoDivider from '../../components/DecoDivider.astro';
import { Content as AboutContent, frontmatter } from '../../../content/about.md';
---

<Base
  title="About — Theo Farrell"
  description="Theo Farrell — beyond AI safety: community volunteering, tutoring, and music"
  ogUrl="https://theosdoor.github.io/about/"
>
  <main class="mx-auto w-full max-w-[800px] px-5 py-16 sm:px-8" id="main" tabindex="-1">
    <header class="mb-10 animate-[fade-up_0.7s_var(--ease-smooth)_forwards]">
      <p class="mb-3 font-sans text-xs font-semibold uppercase tracking-[0.28em] text-accent-strong">{frontmatter.subtitle}</p>
      <h1 class="mb-6 font-serif text-4xl font-black leading-tight text-ink sm:text-5xl">{frontmatter.title}</h1>
      <DecoDivider class="max-w-44" />
    </header>

    <div
      class="prose max-w-none font-sans text-sm leading-[1.6rem] tracking-wide text-muted
             [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:font-black [&_h2]:text-ink [&_h2]:mt-12 [&_h2]:mb-4
             [&_p]:mb-6 [&_p]:text-muted [&_p]:leading-[1.6rem]
             [&_strong]:font-semibold [&_strong]:text-ink
             [&_ul]:list-none [&_ul]:pl-0 [&_ul]:space-y-4 [&_ul]:mb-6
             [&_ul_li]:relative [&_ul_li]:pl-6 [&_ul_li]:text-muted [&_ul_li]:leading-[1.5rem]
             [&_ul_li::before]:content-[''] [&_ul_li::before]:absolute [&_ul_li::before]:left-1 [&_ul_li::before]:top-[9px] [&_ul_li::before]:size-1.5 [&_ul_li::before]:rounded-full [&_ul_li::before]:bg-accent"
    >
      <AboutContent />
    </div>
  </main>
</Base>
