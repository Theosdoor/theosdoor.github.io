  description="Theo Farrell — Portfolio of field-building projects in AI Safety"
  ogUrl="https://theosdoor.github.io/field-building/"
>
  <main class="mx-auto w-full max-w-[800px] px-5 py-16 sm:px-8" id="main" tabindex="-1">
    <div class="flex flex-col gap-16">
      <FieldBuilding />
      <Awards heading="Grants & funding" categories={['field-building']} headingLevel="h2" seeAll />
    </div>
  </main>
