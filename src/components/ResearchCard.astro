---
import Icon from './Icon.astro';
import { formatAuthors } from '../utils/formatters';
import pubsData from '../../content/pubs.yaml';

const owner: string = pubsData.owner;

interface Pub {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  url: string;
  link_label?: string;
  thumbnail?: string;
  'key-role': boolean;
}

interface Props {
  pub: Pub;
}

const { pub } = Astro.props;
---

<a
  href={pub.url}
  target="_blank"
  rel="noopener"
  class="group flex h-full flex-col border border-rule bg-panel text-ink transition duration-200 ease-deco hover:-translate-y-0.5 hover:border-accent"
>
  {/* Thumbnail or Fallback */}
  <div class="aspect-[4/3] bg-panel overflow-hidden border-b border-rule flex items-center justify-center">
    {pub.thumbnail ? (
      <img
        src={pub.thumbnail}
        alt={pub.title}
        class="size-full object-cover object-top"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <img
        src="/images/icons/article.svg"
        alt="Publication icon"
        class="size-16 opacity-40 select-none pointer-events-none"
        loading="lazy"
      />
    )}
  </div>

  {/* Card Body */}
  <div class="p-5 flex flex-col flex-1">
    <h4 class="font-serif text-base font-bold text-ink mb-2 leading-snug group-hover:text-accent transition duration-200 line-clamp-3">
      {pub.title}
    </h4>
    
    <p class="font-sans text-xs leading-5 text-muted mb-2" set:html={formatAuthors(pub.authors, owner)} />
    
    <p class="font-sans text-[0.65rem] uppercase tracking-wider text-accent-strong mb-4">
       {pub.venue} <!-- ({pub.year}) --> <!-- NOTE venue usually includes year so don't include year-->
    </p>

    <span class="mt-auto inline-flex items-center gap-2 font-sans text-[0.65rem] font-bold uppercase tracking-widest text-ink group-hover:text-accent transition duration-200">
      <Icon name="external-link" class="size-3" />
      {pub.link_label ?? 'View paper'}
    </span>
  </div>
</a>
