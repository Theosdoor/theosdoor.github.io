---
import { getCollection } from 'astro:content';
import { formatDate, parseMarkdownLinks } from '../utils/formatters';

interface Talk {
  date: string;
  event: string;
  venue: string;
  topic: 'research' | 'other';
  description: string;
}

const rawTalks = await getCollection('talks');
const talks: Talk[] = rawTalks.map(t => t.data).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<section class="space-y-0 scroll-mt-20 animate-[fade-up_0.7s_var(--ease-smooth)_forwards]" id="talks" aria-live="polite">
  <div class="mb-6 border-b border-rule pb-3 flex items-center justify-between">
    <h3 class="font-serif text-2xl font-black text-ink">Talks</h3>
  </div>

  {talks.length === 0 ? (
    <p class="font-sans text-sm text-subtle py-2">No talks listed yet.</p>
  ) : (
    <div class="divide-y divide-rule/50">
      {talks.map((talk) => (
        <article class="py-6 first:pt-0 last:pb-0">
          <h4 class="mb-2 font-serif text-xl font-bold leading-snug text-ink">{talk.event}</h4>
          <div class="mb-4 flex flex-wrap items-center gap-2 text-xs font-sans text-subtle font-semibold uppercase tracking-wider">
            <span>{formatDate(talk.date)}</span>
            <span>&bull;</span>
            <span>{talk.venue}</span>
          </div>
          <p class="font-sans text-sm leading-8 text-muted" set:html={parseMarkdownLinks(talk.description)} />
        </article>
      ))}
    </div>
  )}
</section>
