---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  hideThemeToggle?: boolean;
}

const { hideThemeToggle = false } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-rule bg-panel/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-[960px] items-center justify-between px-5">
    <!-- Logo / Brand Link -->
    <a href="/" class="font-serif text-lg font-bold tracking-wide text-ink hover:text-accent transition-colors" data-logo-link>
      Theo Farrell
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 font-sans text-xs font-semibold uppercase tracking-[0.16em]" aria-label="Desktop navigation">
      <a href="/" class="nav-link hover:text-accent transition-colors text-subtle" data-tab-link="home">Home</a>
      <a href="/#projects" class="nav-link hover:text-accent transition-colors text-subtle" data-tab-link="projects">Projects</a>
      <a href="/cv/" class="nav-link hover:text-accent transition-colors text-subtle" target="_blank" rel="noopener noreferrer">CV</a>
      <a href="/#chat" class="nav-link inline-flex items-center justify-center border border-accent rounded-lg px-4 py-2.5 text-accent hover:bg-accent hover:text-white transition-all" data-tab-link="chat">Let's Chat</a>
      {!hideThemeToggle && <ThemeToggle class="relative right-auto top-auto z-auto p-1.5 border-0 bg-transparent" />}
    </nav>

    <!-- Mobile Navigation Actions -->
    <div class="flex items-center gap-4 md:hidden">
      {!hideThemeToggle && <ThemeToggle class="relative right-auto top-auto z-auto p-1.5 border-0 bg-transparent" />}
      <button id="menuToggle" class="text-ink p-1 focus:outline-none" aria-label="Toggle menu" aria-expanded="false">
        <svg class="size-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path class="menu-open" d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
          <path class="menu-close hidden" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobileMenu" class="hidden absolute top-16 left-0 w-full bg-panel border-b border-rule px-6 py-6 md:hidden flex flex-col gap-5 font-sans text-sm font-semibold uppercase tracking-[0.16em]" aria-label="Mobile navigation">
    <a href="/" class="mobile-nav-link hover:text-accent transition-colors text-subtle py-1" data-tab-link="home">Home</a>
    <a href="/#projects" class="mobile-nav-link hover:text-accent transition-colors text-subtle py-1" data-tab-link="projects">Projects</a>
    <a href="/cv/" class="mobile-nav-link hover:text-accent transition-colors text-subtle py-1" target="_blank" rel="noopener noreferrer">CV</a>
    <a href="/#chat" class="mobile-nav-link inline-flex items-center justify-center border border-accent rounded-lg px-4 py-2.5 text-accent hover:bg-accent hover:text-white transition-all w-full text-center" data-tab-link="chat">Let's Chat</a>
  </div>
</header>

<script>
  (() => {
    // 1. Mobile Menu Toggle Logic
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    const openIcon = menuToggle?.querySelector('.menu-open');
    const closeIcon = menuToggle?.querySelector('.menu-close');

    menuToggle?.addEventListener('click', () => {
      const isHidden = mobileMenu?.classList.toggle('hidden');
      menuToggle.setAttribute('aria-expanded', String(!isHidden));
      openIcon?.classList.toggle('hidden', !isHidden);
      closeIcon?.classList.toggle('hidden', isHidden);
    });

    // Close menu when clicking a link
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        menuToggle?.setAttribute('aria-expanded', 'false');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });

    // 2. Client-Side Tab Switching Navigation Logic (Only active on homepage)
    const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');
    if (panels.length === 0) return; // Not on homepage, let links navigate normally

    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]');
    const allTabLinks = [...desktopLinks, ...mobileLinks] as HTMLAnchorElement[];
    const logoLink = document.querySelector('[data-logo-link]');

    function panelFromHash(hash: string): string {
      if (hash === '#projects') return 'panel-projects';
      if (hash === '#chat') return 'panel-chat';
      return 'panel-home';
    }

    function hashFromPanel(panelId: string): string {
      if (panelId === 'panel-projects') return '#projects';
      if (panelId === 'panel-chat') return '#chat';
      return '';
    }

    function activate(panelId: string): void {
      const activeType = panelId.replace('panel-', '');

      allTabLinks.forEach((link) => {
        const isButton = link.classList.contains('border-accent');
        const linkType = link.getAttribute('data-tab-link');
        const isActive = linkType === activeType;

        if (isButton) {
          link.classList.toggle('bg-accent', isActive);
          link.classList.toggle('text-white', isActive);
          link.classList.toggle('text-accent', !isActive);
        } else {
          link.classList.toggle('text-accent', isActive);
          link.classList.toggle('text-subtle', !isActive);
        }
      });

      panels.forEach((p) => {
        if (p.id === panelId) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    }

    // Intercept clicks on tab links on `/`
    allTabLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const linkType = link.getAttribute('data-tab-link');
        if (!linkType) return; // Normal link (e.g. CV)

        e.preventDefault();
        const panelId = `panel-${linkType}`;
        const hash = hashFromPanel(panelId);
        if (location.hash !== hash) {
          history.pushState({ panelId }, '', hash || (location.pathname + location.search));
        }
        activate(panelId);
      });
    });

    // Clicking the logo on homepage should switch to home tab
    logoLink?.addEventListener('click', (e) => {
      e.preventDefault();
      if (location.hash !== '') {
        history.pushState({ panelId: 'panel-home' }, '', location.pathname + location.search);
      }
      activate('panel-home');
    });

    // Handle back/forward history navigation
    window.addEventListener('popstate', () => {
      activate(panelFromHash(location.hash));
    });

    // Initial activation based on URL hash
    activate(panelFromHash(location.hash));
  })();
</script>
