---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  hideThemeToggle?: boolean;
}

const { hideThemeToggle = false } = Astro.props;

const navLinks = [
  { href: '/research/', label: 'Research' },
  { href: '/field-building/', label: 'Field-building' },
  { href: '/projects/', label: 'Projects' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href;
---

<header class="sticky top-0 z-40 w-full border-b border-rule bg-panel/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-[960px] items-center justify-between px-5">
    <!-- Logo / Brand Link -->
    <a href="/" class="font-serif text-lg font-bold tracking-wide text-ink hover:text-accent transition-colors">
      Theo Farrell
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 font-sans text-xs font-semibold uppercase tracking-[0.16em]" aria-label="Desktop navigation">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-link hover:text-accent transition-colors', isCurrent(href) ? 'text-accent' : 'text-subtle']}
          aria-current={isCurrent(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
      <a href="/cv/" class="nav-link hover:text-accent transition-colors text-subtle" target="_blank" rel="noopener noreferrer">CV</a>
      <a href="/lets-chat/" class="nav-link inline-flex items-center justify-center border border-accent rounded-lg px-4 py-2.5 text-accent hover:bg-accent hover:text-white transition-all">Let's Talk</a>
      {!hideThemeToggle && <ThemeToggle class="relative right-auto top-auto z-auto p-1.5 border-0 bg-transparent" />}
    </nav>

    <!-- Mobile Navigation Actions -->
    <div class="flex items-center gap-4 md:hidden">
      {!hideThemeToggle && <ThemeToggle class="relative right-auto top-auto z-auto p-1.5 border-0 bg-transparent" />}
      <button id="menuToggle" class="text-ink p-1 focus:outline-none" aria-label="Toggle menu" aria-expanded="false">
        <svg class="size-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path class="menu-open" d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
          <path class="menu-close hidden" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobileMenu" class="hidden absolute top-16 left-0 w-full bg-panel border-b border-rule px-6 py-6 md:hidden flex flex-col gap-5 font-sans text-sm font-semibold uppercase tracking-[0.16em]" aria-label="Mobile navigation">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class:list={['mobile-nav-link hover:text-accent transition-colors py-1', isCurrent(href) ? 'text-accent' : 'text-subtle']}
        aria-current={isCurrent(href) ? 'page' : undefined}
      >
        {label}
      </a>
    ))}
    <a href="/cv/" class="mobile-nav-link hover:text-accent transition-colors text-subtle py-1" target="_blank" rel="noopener noreferrer">CV</a>
    <a href="/lets-chat/" class="mobile-nav-link inline-flex items-center justify-center border border-accent rounded-lg px-4 py-2.5 text-accent hover:bg-accent hover:text-white transition-all w-full text-center">Let's Talk</a>
  </div>
</header>

<script>
  (() => {
    // Mobile menu toggle
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    const openIcon = menuToggle?.querySelector('.menu-open');
    const closeIcon = menuToggle?.querySelector('.menu-close');

    menuToggle?.addEventListener('click', () => {
      const isHidden = mobileMenu?.classList.toggle('hidden');
      menuToggle.setAttribute('aria-expanded', String(!isHidden));
      openIcon?.classList.toggle('hidden', !isHidden);
      closeIcon?.classList.toggle('hidden', isHidden);
    });

    // Close menu when following a link
    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        menuToggle?.setAttribute('aria-expanded', 'false');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });
  })();
</script>
