---
import Icon from './Icon.astro';
import pubsData from '../../content/pubs.yaml';

const owner: string = pubsData.owner;
const [ownerFirst, ...ownerRest] = owner.split(' ');
const ownerLast = ownerRest.at(-1) ?? '';

interface Pub {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  url: string;
  link_label?: string;
  'key-role': boolean;
}

interface Props {
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const allPubs: Pub[] = [...pubsData.publications].sort((a: Pub, b: Pub) => b.year - a.year);
const keyPubs = allPubs.filter((p: Pub) => p['key-role'] === true);
const otherPubs = allPubs.filter((p: Pub) => p['key-role'] === false);

function formatAuthors(authors: string[]): string {
  return authors
    .map((a) => {
      const isOwner =
        a === owner ||
        (a.includes(ownerFirst) && a.includes(ownerLast));
      return isOwner ? `<strong>${a}</strong>` : a;
    })
    .join(', ');
}
---

<section class="space-y-0 animate-[fade-up_0.7s_var(--ease-smooth)_forwards]" id="research-section" aria-live="polite">
  <Heading class="mb-4 border-b border-rule pb-3 font-serif text-3xl font-black text-ink">Research</Heading>
  
  <!-- Jump Navigation -->
  <nav class="mb-10 flex flex-wrap gap-3 font-sans text-xs font-semibold uppercase tracking-[0.16em]" aria-label="Research sections">
    <a href="#key-role" class="border border-accent rounded-lg px-4 py-2 text-accent hover:bg-accent hover:text-white transition-all">Key Role Papers</a>
    <a href="#other-papers" class="border border-accent rounded-lg px-4 py-2 text-accent hover:bg-accent hover:text-white transition-all">Other Contributions</a>
    <a href="#talks" class="border border-accent rounded-lg px-4 py-2 text-accent hover:bg-accent hover:text-white transition-all">Talks</a>
  </nav>

  <!-- Section 1: Key Role Papers -->
  <div class="pt-2 mb-12 scroll-mt-20" id="key-role">
    <h3 class="mb-6 font-serif text-2xl font-black text-ink border-b-2 border-accent/20 pb-3">
      Published papers I played a key role in creating:
    </h3>
    <div class="divide-y divide-rule">
      {keyPubs.map((pub) => (
        <article class="group py-6 first:pt-0 last:pb-0">
          <h4 class="mb-3 font-serif text-lg sm:text-xl font-bold leading-snug text-ink group-hover:text-accent transition-colors">
            <a href={pub.url} target="_blank" rel="noopener" class="focus:outline-none">
              {pub.title}
            </a>
          </h4>
          <p class="mb-2 font-sans text-sm leading-7 text-muted" set:html={formatAuthors(pub.authors)} />
          <p class="mb-3 font-sans text-sm text-accent">{pub.venue}</p>
          <a class="inline-flex items-center gap-2 border-b border-rule pb-1 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-ink hover:border-accent hover:text-accent" href={pub.url} target="_blank" rel="noopener">
            <Icon name="external-link" class="size-3" />
            {pub.link_label ?? 'View paper'}
          </a>
        </article>
      ))}
    </div>
  </div>

  <!-- Section 2: Other Contributions -->
  <div class="pt-2 scroll-mt-20" id="other-papers">
    <h3 class="mb-6 font-serif text-2xl font-black text-ink border-b-2 border-accent/20 pb-3">
      Other published papers I’ve helped with:
    </h3>
    <div class="divide-y divide-rule">
      {otherPubs.map((pub) => (
        <article class="group py-6 first:pt-0 last:pb-0">
          <h4 class="mb-3 font-serif text-lg sm:text-xl font-bold leading-snug text-ink group-hover:text-accent transition-colors">
            <a href={pub.url} target="_blank" rel="noopener" class="focus:outline-none">
              {pub.title}
            </a>
          </h4>
          <p class="mb-2 font-sans text-sm leading-7 text-muted" set:html={formatAuthors(pub.authors)} />
          <p class="mb-3 font-sans text-sm text-accent">{pub.venue}</p>
          <a class="inline-flex items-center gap-2 border-b border-rule pb-1 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-ink hover:border-accent hover:text-accent" href={pub.url} target="_blank" rel="noopener">
            <Icon name="external-link" class="size-3" />
            {pub.link_label ?? 'View paper'}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
