---
import ResearchCard from './ResearchCard.astro';

interface Pub {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  url: string;
  link_label?: string;
  thumbnail?: string;
  'key-role': boolean;
}

interface Props {
  papers: Pub[];
  title: string;
  id: string;
}

const { papers, title, id } = Astro.props;
---

<div class="carousel-section mb-10">
  <div class="flex items-center justify-between mb-6 border-b border-rule pb-3">
    <h3 class="font-serif text-2xl font-black text-ink">
      {title}
    </h3>
    
    <div class="flex gap-2">
      <button 
        class="carousel-prev p-2 border border-rule text-muted hover:border-accent hover:text-accent transition duration-150 rounded-none disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
        aria-label="Scroll previous"
        disabled
      >
        <svg class="size-4 fill-current" viewBox="0 0 320 512" aria-hidden="true" focusable="false">
          <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 246.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z" />
        </svg>
      </button>
      <button 
        class="carousel-next p-2 border border-rule text-muted hover:border-accent hover:text-accent transition duration-150 rounded-none disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
        aria-label="Scroll next"
      >
        <svg class="size-4 fill-current" viewBox="0 0 320 512" aria-hidden="true" focusable="false">
          <path d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z" />
        </svg>
      </button>
    </div>
  </div>
  
  <div class="relative">
    <div 
      id={id}
      class="carousel-track flex gap-5 overflow-x-auto scroll-smooth pb-4 snap-x snap-mandatory scrollbar-hide"
    >
      {papers.map(paper => (
        <div class="carousel-item flex-shrink-0 w-72 snap-start">
          <ResearchCard pub={paper} />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  /* Responsive card widths */
  @media (max-width: 640px) {
    .carousel-item {
      width: 80vw;
      max-width: 280px;
    }
  }
</style>

<script>
  function setupCarousels() {
    document.querySelectorAll('.carousel-section').forEach(section => {
      const track = section.querySelector('.carousel-track') as HTMLElement;
      const prevBtn = section.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = section.querySelector('.carousel-next') as HTMLButtonElement;

      if (!track || !prevBtn || !nextBtn) return;

      const updateButtons = () => {
        const scrollLeft = track.scrollLeft;
        const maxScroll = track.scrollWidth - track.clientWidth;
        
        // Disable prev if we are scrolled all the way to the left
        prevBtn.disabled = scrollLeft <= 2;
        // Disable next if we are scrolled all the way to the right or if there is no overflow to scroll
        nextBtn.disabled = scrollLeft >= maxScroll - 2 || maxScroll <= 0;
      };

      const cardWidth = 288 + 20; // card width (288px) + gap (20px)
      
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: cardWidth, behavior: 'smooth' });
      });

      track.addEventListener('scroll', updateButtons);

      // Use ResizeObserver to update button states when visibility/size changes (e.g. switching tabs)
      const resizeObserver = new ResizeObserver(() => {
        updateButtons();
      });
      resizeObserver.observe(track);

      // Initial check
      updateButtons();
    });
  }

  // Setup on initial load
  setupCarousels();
  
  // Re-run setup on DOMContentLoaded and page loads
  document.addEventListener('DOMContentLoaded', setupCarousels);
</script>
