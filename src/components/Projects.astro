---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { isPassthrough, isVideo, resolveImage } from "../utils/images";
import { curatedCompare } from "../utils/projects-view";

interface Props {
  urlSync?: boolean;
  headingLevel?: "h1" | "h2";
}

const { urlSync = false, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
// Filter groups and card titles sit one level below the section heading.
const SubHeading = headingLevel === "h1" ? "h2" : "h3";

// Loaded from content/projects.yaml through the projects content collection
const rawProjects = await getCollection("projects");
// Server-rendered in curated order; non-highlights start hidden behind the
// "Show N more" divider (projects.ts takes over from here).
const projects = rawProjects.map((p) => p.data).sort(curatedCompare);
const restCount = projects.filter((p) => p.highlight == null).length;

// Filter buttons are toggles: projects.ts flips aria-pressed and the
// aria-pressed: variants restyle them, so state and styling cannot drift apart.
const pill =
  "proj-pill border border-rule px-3 py-1 font-sans text-xs uppercase tracking-wider text-muted transition duration-150 hover:border-accent hover:text-ink aria-pressed:border-accent aria-pressed:text-accent";
const filterHeading =
  "mb-2 font-serif text-[0.65rem] font-bold uppercase tracking-wider text-accent-strong";

const allLanguages = [
  ...new Set(projects.flatMap((p) => p.languages ?? [])),
].sort();
const allTools = [
  ...new Set(projects.flatMap((p) => (p.tools ?? []).filter(Boolean))),
].sort();
---

<section class="space-y-6 animate-fade-up">
  <Heading
    class="mb-4 border-b border-rule pb-3 font-serif text-3xl font-black text-ink"
    >Projects</Heading
  >

  {
    projects.length === 0 ? (
      <p>No projects yet — check back soon.</p>
    ) : (
      <>
        <div class="relative mb-6">
          <div class="flex flex-wrap gap-4">
            <button
              class="proj-filter-btn border-b border-rule pb-1 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-muted hover:border-accent hover:text-accent aria-expanded:border-accent aria-expanded:text-accent data-active:border-accent data-active:text-accent"
              id="proj-filter-btn"
              aria-expanded="false"
              aria-controls="proj-filter-panel"
            >
              Filter ▾
            </button>
            {/* Sort switch: aria-checked="true" means Newest. The words and the
                 diamond knob restyle from it through group-aria-checked: variants. */}
            <button
              id="proj-sort-switch"
              type="button"
              role="switch"
              aria-checked="false"
              aria-label="Sort by newest"
              class="group inline-flex items-center gap-2 pb-1 font-sans text-xs font-semibold uppercase tracking-[0.16em]"
            >
              <span class="text-accent transition-colors duration-150 group-aria-checked:text-muted" aria-hidden="true">Curated</span>
              <span class="relative inline-block h-3 w-8" aria-hidden="true">
                <span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-rule transition-colors duration-150 group-hover:bg-accent"></span>
                <span class="absolute left-0.5 top-1/2 size-2 -translate-y-1/2 rotate-45 bg-accent transition-transform duration-200 ease-deco group-aria-checked:translate-x-5 motion-reduce:transition-none"></span>
              </span>
              <span class="text-muted transition-colors duration-150 group-aria-checked:text-accent" aria-hidden="true">Newest</span>
            </button>
            <input
              class="proj-search min-w-40 border-b border-rule bg-transparent pb-1 font-sans text-xs tracking-wider text-ink placeholder:text-subtle focus:border-accent"
              id="proj-search"
              type="search"
              placeholder="Search…"
              aria-label="Search projects"
            />
          </div>

          {/* Without JS the dividers cannot open, so show every card and hide
               them instead of stranding the non-highlights. Tailwind's `[hidden]`
               reset is !important inside @layer base, and a layered !important beats
               an unlayered one, so this sits in the same layer and wins on specificity. */}
          <noscript>
            <style is:inline>
              @layer base {
                #proj-list .proj[hidden] { display: flex !important; }
                #proj-list .proj-divider { display: none !important; }
              }
            </style>
          </noscript>

          <div
            class="proj-dropdown absolute z-20 mt-3 min-w-[280px] border border-rule bg-panel p-4 text-ink"
            id="proj-filter-panel"
            hidden
          >
            <div class="proj-filter-section mb-4 last:mb-0">
              <SubHeading class={filterHeading}>
                Role
              </SubHeading>
              <div class="proj-pills flex flex-wrap gap-2">
                <button
                  class={pill}
                  aria-pressed="true"
                  data-filter-role="all"
                >
                  All
                </button>
                <button
                  class={pill}
                  aria-pressed="false"
                  data-filter-role="lead"
                >
                  Lead
                </button>
                <button
                  class={pill}
                  aria-pressed="false"
                  data-filter-role="contributor"
                >
                  Contributor
                </button>
              </div>
            </div>

            <div class="proj-filter-section mb-4 last:mb-0">
              <SubHeading class={filterHeading}>
                Category
              </SubHeading>
              <div class="proj-pills flex flex-wrap gap-2">
                <button
                  class={pill}
                  aria-pressed="true"
                  data-filter-category="all"
                >
                  All
                </button>
                <button
                  class={pill}
                  aria-pressed="false"
                  data-filter-category="research"
                >
                  Research
                </button>
                <button
                  class={pill}
                  aria-pressed="false"
                  data-filter-category="coursework"
                >
                  Coursework
                </button>
                <button
                  class={pill}
                  aria-pressed="false"
                  data-filter-category="side-project"
                >
                  Side project
                </button>
              </div>
            </div>

            <div class="proj-filter-section mb-4 last:mb-0">
              <SubHeading class={filterHeading}>
                Languages
              </SubHeading>
              <div class="proj-tag-chips flex flex-wrap gap-2">
                <button
                  class:list={[pill, "proj-tag-chip"]}
                  aria-pressed="true"
                  data-filter-lang="any"
                >
                  Any
                </button>
                {allLanguages.map((lang) => (
                  <button
                    class:list={[pill, "proj-tag-chip"]}
                  aria-pressed="false"
                    data-filter-lang={lang.toLowerCase()}
                  >
                    {lang}
                  </button>
                ))}
              </div>
            </div>

            <div class="proj-filter-section mb-4 last:mb-0">
              <SubHeading class={filterHeading}>
                Tools
              </SubHeading>
              <div class="proj-tag-chips flex flex-wrap gap-2">
                <button
                  class:list={[pill, "proj-tag-chip"]}
                  aria-pressed="true"
                  data-filter-tool="any"
                >
                  Any
                </button>
                {allTools.map((tool) => (
                  <button
                    class:list={[pill, "proj-tag-chip"]}
                  aria-pressed="false"
                    data-filter-tool={tool.toLowerCase()}
                  >
                    {tool}
                  </button>
                ))}
              </div>
            </div>

            <div class="proj-filter-section mb-4 last:mb-0">
              <SubHeading class={filterHeading}>
                Focus
              </SubHeading>
              <div class="proj-pills flex flex-wrap gap-2">
                <button
                  class={pill}
                  aria-pressed="true"
                  data-filter-ais="all"
                >
                  All
                </button>
                <button
                  class={pill}
                  aria-pressed="false"
                  data-filter-ais="true"
                >
                  AI Safety
                </button>
              </div>
            </div>
          </div>

        </div>

        <div
          class="proj-list grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(min(260px,100%),1fr))]"
          id="proj-list"
          data-url-sync={urlSync ? "true" : "false"}
        >
          <div
            class="placeholder border border-dashed border-rule bg-panel px-6 py-12 text-center text-sm tracking-wide text-subtle hidden col-span-full"
            id="proj-empty-state"
          >
            No projects match the current filters.
          </div>
          {projects.map((p) => {
            // Cards without a link render as a plain block with the same styling.
            const Card = p.url ? "a" : "div";
            return (
            <Card
              class="proj-card proj group flex flex-col border border-rule bg-panel text-ink transition duration-200 ease-deco hover:-translate-y-0.5 hover:border-accent"
              href={p.url}
              target={p.url ? "_blank" : undefined}
              rel={p.url ? "noopener noreferrer" : undefined}
              data-role={p.role}
              data-category={p.category}
              data-highlight={p.highlight ?? ""}
              hidden={p.highlight == null}
              data-year={String(p.year ?? 0)}
              data-languages={(p.languages ?? [])
                .map((l) => l.toLowerCase())
                .join(",")}
              data-tools={(p.tools ?? [])
                .filter(Boolean)
                .map((t) => t.toLowerCase())
                .join(",")}
              data-ais={p.ais ? "true" : "false"}
            >
              <div class="proj-card-img aspect-[16/10] overflow-hidden border-b border-rule">
                {p.image ? (
                  isVideo(p.image) ? (
                    <video
                      class="size-full object-cover"
                      src={p.image}
                      data-autoplay
                      preload="metadata"
                      loop
                      muted
                      playsinline
                      aria-label={p.title}
                    />
                  ) : isPassthrough(p.image) ? (
                    <img
                      class="size-full object-cover"
                      src={p.image}
                      alt={p.title}
                      loading="lazy"
                    />
                  ) : (
                    <Image
                      class="size-full object-cover"
                      src={resolveImage(p.image)}
                      alt={p.title}
                      width={480}
                      height={300}
                      densities={[2]}
                      format="webp"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                    />
                  )
                ) : (
                  <div class="proj-card-placeholder flex size-full items-center justify-center bg-canvas font-serif text-3xl font-bold text-subtle">
                    {p.title[0]}
                  </div>
                )}
              </div>
              <div class="proj-card-body flex flex-1 flex-col p-5">
                {p.ais && (
                  <span class="proj-ais-badge mb-3 self-start border border-safety px-2 py-1 font-sans text-[0.65rem] font-semibold uppercase tracking-wider text-safety">
                    AI Safety
                  </span>
                )}
                <SubHeading class="proj-card-title font-serif text-lg font-bold text-ink mb-1">
                  {p.title}
                </SubHeading>
                {p.venue && (
                  <p class="proj-card-venue font-sans text-[0.65rem] italic text-muted mb-1">
                    {p.venue}
                  </p>
                )}
                <p class="proj-card-desc font-sans text-sm leading-6 text-muted">
                  {p.description}
                </p>
                <div class="proj-chips mt-auto flex flex-wrap gap-2 pt-4">
                  <span class="proj-chip border border-accent px-2 py-1 font-sans text-[0.65rem] uppercase tracking-wider text-accent">
                    {p.role}
                  </span>
                  <span class="proj-chip border border-accent px-2 py-1 font-sans text-[0.65rem] uppercase tracking-wider text-accent">
                    {p.category}
                  </span>
                </div>
                {((p.languages ?? []).length > 0 ||
                  (p.tools ?? []).filter(Boolean).length > 0) && (
                  <div class="proj-tags mt-2 flex flex-wrap gap-2">
                    {(p.languages ?? []).map((l) => (
                      <span class="proj-tag border border-rule px-2 py-1 font-sans text-[0.65rem] uppercase tracking-wider text-subtle">
                        {l}
                      </span>
                    ))}
                    {(p.tools ?? []).filter(Boolean).map((t) => (
                      <span class="proj-tag border border-rule px-2 py-1 font-sans text-[0.65rem] uppercase tracking-wider text-subtle">
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </Card>
            );
          })}
          {/* Dividers between the highlights and the rest; projects.ts places them
               and sets their text. Server-rendered closed, as the page loads. */}
          {["top", "bottom"].map((pos) => (
            <div
              class="proj-divider col-span-full flex items-center gap-4 py-2"
              data-divider={pos}
              hidden={pos === "bottom" || restCount === 0}
            >
              <span class="h-px flex-1 bg-rule" aria-hidden="true" />
              <button
                type="button"
                class="group inline-flex items-center gap-2 font-sans text-xs font-semibold uppercase tracking-[0.16em] text-muted transition-colors duration-150 hover:text-accent focus-visible:text-accent"
                aria-expanded="false"
                aria-controls="proj-list"
              >
                <span class="proj-divider-label">{`Show ${restCount} more ${restCount === 1 ? "project" : "projects"}`}</span>
                <svg
                  class="size-3 transition-transform duration-300 ease-deco group-aria-expanded:rotate-180 motion-reduce:transition-none"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M2 4.5 6 8.5 10 4.5" />
                </svg>
              </button>
              <span class="h-px flex-1 bg-rule" aria-hidden="true" />
            </div>
          ))}
        </div>

      </>
    )
  }
</section>

<script>
  import { initializeProjectsFilter } from "../scripts/projects";

  const list = document.getElementById("proj-list");
  if (list) {
    const urlSync = list.dataset.urlSync === "true";
    initializeProjectsFilter({ urlSync });
  }
</script>
