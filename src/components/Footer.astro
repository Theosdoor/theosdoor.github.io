---
import { execSync } from 'child_process';
import ContactEmail from './ContactEmail.astro';
import { cvUrl } from '../utils/constants';

let lastUpdated = '';
try {
  lastUpdated = execSync('git log -1 --format="%cd" --date=format:"%d %b %Y"')
    .toString()
    .trim();
} catch (e) {
  const now = new Date();
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const day = String(now.getDate()).padStart(2, '0');
  const month = months[now.getMonth()];
  const year = now.getFullYear();
  lastUpdated = `${day} ${month} ${year}`;
}
---

<footer class="mx-auto mt-16 w-full max-w-[960px] border-t border-rule px-5 py-8 sm:px-8">
  <div class="flex flex-col items-center justify-center gap-5 text-center">
    <!-- Email (socials live in the header) -->
    <ContactEmail class="justify-center font-sans text-xs tracking-[0.12em] text-subtle" />

    <!-- Links Row -->
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-sans text-xs font-semibold uppercase tracking-[0.16em]" aria-label="Footer navigation">
      <a href="/" class="text-subtle hover:text-accent transition-colors duration-200">Home</a>
      <a href="/research/" class="text-subtle hover:text-accent transition-colors duration-200">Research</a>
      <a href="/field-building/" class="text-subtle hover:text-accent transition-colors duration-200">Field-building</a>
      <a href="/projects/" class="text-subtle hover:text-accent transition-colors duration-200">Projects</a>
      <a href="/talks/" class="text-subtle hover:text-accent transition-colors duration-200">Talks</a>
      <a href="/awards/" class="text-subtle hover:text-accent transition-colors duration-200">Grants &amp; Awards</a>
      <a href="/about/" class="text-subtle hover:text-accent transition-colors duration-200">About</a>
      <a href={cvUrl} class="text-subtle hover:text-accent transition-colors duration-200" target="_blank" rel="noopener noreferrer">CV</a>
      <a href="/lets-chat/" class="text-subtle hover:text-accent transition-colors duration-200">Let's Talk</a>
    </nav>

    <!-- Metadata & Repository Link (Fine Print) -->
    <a href="https://github.com/Theosdoor/theosdoor.github.io" target="_blank" rel="noopener noreferrer" class="font-sans text-[9px] sm:text-[10px] uppercase tracking-[0.16em] text-subtle/80 hover:text-accent transition-colors duration-200">
      Last updated: {lastUpdated}
    </a>
  </div>
</footer>
