---
interface Props {
  title: string;
  description: string;
  /** Defaults to the canonical URL of the current page. */
  ogUrl?: string;
  ogImage?: string;
}

// The 404 page is served at whichever URL was missed, so it has no canonical address.
const isNotFound = /^\/404\/?$/.test(Astro.url.pathname);
const canonicalUrl = isNotFound ? undefined : new URL(Astro.url.pathname, Astro.site).href;

const {
  title,
  description,
  ogUrl = canonicalUrl,
  ogImage = '/images/og.jpg',
} = Astro.props;

const ogImageAbsolute = new URL(ogImage, Astro.site).href;

import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RetroMode from '../components/RetroMode.astro';
import '../styles/global.css';
import '../styles/retro.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="google-site-verification" content="BD22yCN98mhUEUuWtahSEQ18Jsti83oPb6WgG3LuCCw" />
    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Fonts: each family is one variable woff2 covering every weight, so preload both */}
    <Font cssVariable="--font-merriweather" preload />
    <Font cssVariable="--font-raleway" preload />
    {/* Used only by the secret 2000s mode; browsers fetch it only when retro text needs it */}
    <Font cssVariable="--font-comic-neue" />
    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#7d3c52" />
    <slot name="head" />
    <script is:inline>
      (() => {
        let theme;
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {}
        theme ||= window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        // Secret 2000s mode (RetroMode.astro), restored before first paint like the theme.
        try {
          if (localStorage.getItem('era') === '2000s') document.documentElement.dataset.era = '2000s';
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:border focus:border-accent focus:bg-panel focus:px-4 focus:py-2 focus:text-ink" href="#main">Skip to main content</a>
    <RetroMode part="top" />
    <Header />
    <slot />
    <RetroMode part="bottom" />
    <Footer />
  </body>
</html>
